<mvc:View
    controllerName="com.myorg.routingdemo.controller.InvoiceList"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc">

    <List
        headerText="Invoice List"
        items="{invoice>/Invoices}">

        <items>

            <ObjectListItem
                title="{invoice>ProductName}"
                intro="{invoice>ShipperName}"
                number="{invoice>ExtendedPrice}"
                type="Navigation"
                press=".onPress">

            </ObjectListItem>

        </items>

    </List>

</mvc:View>